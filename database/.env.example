# Atlas database used by the API over Managed MCP. No MONGODB_URI is needed.
MONGODB_DATABASE=
CORS_ORIGINS=http://localhost:5173

# Atlas Managed MCP configuration: use a newly rotated secret locally.
MDB_MCP_API_CLIENT_ID=
MDB_MCP_API_CLIENT_SECRET=
MDB_MCP_API_BASE_URL=https://mcp.mongodb.com

# Required for API startup and --check-database
MDB_MCP_PROJECT_ID=
MDB_MCP_CLUSTER_NAME=
